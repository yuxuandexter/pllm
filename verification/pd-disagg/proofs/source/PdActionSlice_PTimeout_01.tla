           EExit(i,r,h) == IsP(i) /\ Active(i,r) /\ h \in {"abort","timeout"} /\ PEnd(i,r,h) /\ UNCHANGED gbad


           ECancel(i,r) == ph[i][r] = "reg"


           ELed(i,r) == IF ECancel(i,r) THEN led[rpg[i][r]] \ {rx[i][r]} ELSE led[rpg[i][r]]


           EState(i,r,h) == IF ELed(i,r) = {} /\ sled[rpg[i][r]] = {}
