                  /\ rt' = [rt EXCEPT ![r] = IF ok THEN "ok" ELSE "err"]
                  /\ crep' = [crep EXCEPT ![r][gen[r]] = IF ok THEN "ok" ELSE "err"]
             /\ gbad' = gbad


